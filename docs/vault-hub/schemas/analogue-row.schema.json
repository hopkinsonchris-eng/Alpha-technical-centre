{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.alpha-technical-centre.com/schemas/analogue-row.schema.json",
  "title": "AnalogueRow",
  "description": "Fixed-schema row emitted by every evaluation and by paper/feed extraction, so our own work, the literature and public data form one analogue table. Numbers carry provenance. Extend by adding optional properties, never by renaming.",
  "type": "object",
  "required": ["id", "source_ref", "asset_id", "as_of", "legal_tag", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "source_ref": { "type": "string", "description": "run:<uuid> | doc:<uuid> (evaluation, paper or feed) this row was extracted from" },
    "asset_id": { "type": "string", "description": "Master-data field or reservoir id" },
    "basin_id": { "type": "string" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "as_of": { "type": "string", "format": "date" },
    "legal_tag": { "type": "string", "pattern": "^lt-[a-z0-9-]{3,64}$" },
    "provenance": { "type": "string", "enum": ["own-evaluation", "paper", "regulator", "vendor-database", "client-stated"] },
    "play_type": { "type": "string", "description": "Key into js/analogues.js PLAYS where applicable" },
    "environment": { "type": "string", "enum": ["onshore", "shallow-water", "deep-water", "ultra-deep"] },
    "lithology": { "type": "string", "enum": ["clastic", "carbonate", "mixed", "fractured-basement", "shale", "coal"] },
    "depositional_setting": { "type": "string" },
    "trap_type": { "type": "string" },
    "drive_mechanism": { "type": "string", "enum": ["solution-gas", "gas-cap", "water-drive", "combination", "waterflood", "gas-injection", "eor-polymer", "eor-thermal", "eor-co2", "eor-other", "unknown"] },
    "fluid_type": { "type": "string", "enum": ["black-oil", "volatile-oil", "heavy-oil", "extra-heavy", "gas-condensate", "dry-gas", "wet-gas"] },
    "depth_m": { "$ref": "#/$defs/num" },
    "net_pay_m": { "$ref": "#/$defs/num" },
    "porosity_frac": { "$ref": "#/$defs/num" },
    "permeability_md": { "$ref": "#/$defs/num" },
    "water_saturation_frac": { "$ref": "#/$defs/num" },
    "api_gravity": { "$ref": "#/$defs/num" },
    "oil_viscosity_cp": { "$ref": "#/$defs/num" },
    "gor_scf_stb": { "$ref": "#/$defs/num" },
    "initial_pressure_psi": { "$ref": "#/$defs/num" },
    "temperature_c": { "$ref": "#/$defs/num" },
    "area_km2": { "$ref": "#/$defs/num" },
    "well_spacing_acres": { "$ref": "#/$defs/num" },
    "well_count": { "$ref": "#/$defs/num" },
    "stoiip_mmbbl": { "$ref": "#/$defs/num" },
    "giip_bcf": { "$ref": "#/$defs/num" },
    "recovery_factor_frac": { "$ref": "#/$defs/num" },
    "eur_mmbbl": { "$ref": "#/$defs/num" },
    "eur_per_well_mbbl": { "$ref": "#/$defs/num" },
    "peak_rate_bopd": { "$ref": "#/$defs/num" },
    "decline_rate_pa": { "$ref": "#/$defs/num" },
    "water_cut_frac": { "$ref": "#/$defs/num" },
    "capex_usd_mm": { "$ref": "#/$defs/num" },
    "opex_usd_bbl": { "$ref": "#/$defs/num" },
    "npv10_usd_mm": { "$ref": "#/$defs/num" },
    "irr_frac": { "$ref": "#/$defs/num" },
    "breakeven_usd_bbl": { "$ref": "#/$defs/num" },
    "fiscal_regime_ref": { "type": "string", "description": "ref:fiscal_terms/<country>/<regime>" },
    "price_deck_ref": { "type": "string", "description": "ref:price_decks/<name>" },
    "reserves_1p_mmboe": { "$ref": "#/$defs/num" },
    "reserves_2p_mmboe": { "$ref": "#/$defs/num" },
    "reserves_3p_mmboe": { "$ref": "#/$defs/num" },
    "method": { "type": "array", "items": { "type": "string", "enum": ["performance", "volumetric", "analogy", "simulation", "material-balance", "decline-curve"] } },
    "operator": { "type": "string" },
    "first_production": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "extracted_by": { "type": "string", "description": "Person id or model id" },
    "evidence": { "type": "array", "items": { "type": "object", "required": ["property", "quote"], "properties": { "property": { "type": "string" }, "quote": { "type": "string" }, "location": { "type": "string" } } } }
  },
  "$defs": {
    "num": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "low": { "type": "number" },
        "high": { "type": "number" },
        "provenance": { "type": "string", "enum": ["measured", "reported", "client-stated", "analogue", "assumed", "calculated"] }
      }
    }
  }
}
