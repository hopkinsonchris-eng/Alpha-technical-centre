      "id": "financial-model",
      "name": "Upstream Quick-Look Financial Model",
      "description": "Generic-contract upstream quick-look economics: NPV, IRR, payback, cash flow and sensitivities.",
      "owner": "chris",
      "lifecycle": "production",
      "kind": "browser-tool",
      "entry": "financial-modelling.html",
      "changelog": "tools/financial-model/CHANGELOG.md",
