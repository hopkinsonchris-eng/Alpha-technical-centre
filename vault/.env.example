# vault-api environment (names only; values live in Render and are never committed)
DATABASE_URL=            # Supabase Postgres connection string (Session pooler URI). Unset → embedded PGlite (dev/tests)
DATABASE_SSL_CA=         # optional: provider root certificate (PEM text or file path) to verify the database's certificate
PORT=8787
CF_ACCESS_TEAM_DOMAIN=   # e.g. alphatc.cloudflareaccess.com
CF_ACCESS_AUD=           # Access application audience tag
ALLOWED_EMAIL_DOMAIN=alpha-technical-centre.com
DEV_USER_EMAIL=          # local only: skip Access and act as this staff email
ANTHROPIC_API_KEY=       # M13
VOYAGE_API_KEY=          # M09
SUPABASE_URL=            # M09 storage
SUPABASE_SERVICE_KEY=    # M09 storage
ZOHO_MAIL_IMAP_USER=     # M10
ZOHO_MAIL_IMAP_PASSWORD= # M10
ZOHO_BOOKS_CLIENT_ID=    # M09 (D11)
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
GMAIL_OAUTH_CLIENT_ID=   # M10
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
SITE_ORIGIN=             # M08 re-run runner: the static site's origin, e.g. https://www.alpha-technical-centre.com
RERUN_CHROMIUM=          # M08: path to a Chromium binary when not on the Playwright default path
LLM_PROVIDER=            # 'fake' for tests; unset → Anthropic when ANTHROPIC_API_KEY is set
LLM_MODEL=claude-sonnet-5-5
APP_TOKENS=              # D6: apex-asset-intelligence:<secret>,apex-3d-model:<secret> (≥16 chars each)
APEX_AI_BASE_URL=        # D6: https://apex-app2.onrender.com
APEX_AI_TOKEN=
APEX_3D_BASE_URL=        # D6: https://apex-3d-model.uk
APEX_3D_TOKEN=
APEX_AI_PROJECT=firm
