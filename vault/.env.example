# vault-api environment (names only; values live in Render and are never committed)
DATABASE_URL=            # Supabase Postgres connection string (pooler, sslmode=require). Unset → embedded PGlite (dev/tests)
PORT=8787
CF_ACCESS_TEAM_DOMAIN=   # e.g. alphatc.cloudflareaccess.com
CF_ACCESS_AUD=           # Access application audience tag
ALLOWED_EMAIL_DOMAIN=alpha-technical-centre.com
DEV_USER_EMAIL=          # local only: skip Access and act as this staff email
ANTHROPIC_API_KEY=       # M13
VOYAGE_API_KEY=          # M09
SUPABASE_URL=            # M09 storage
SUPABASE_SERVICE_KEY=    # M09 storage
ZOHO_MAIL_IMAP_USER=     # M10
ZOHO_MAIL_IMAP_PASSWORD= # M10
ZOHO_BOOKS_CLIENT_ID=    # M09 (D11)
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
GMAIL_OAUTH_CLIENT_ID=   # M10
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
