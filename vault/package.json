{
  "name": "atc-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alpha Technical Centre Vault API: store of record for runs, documents, correspondence, legal and billing records, research and lessons.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'test/**/*.test.ts'",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@hono/node-server": "^2.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "docx": "^9.8.1",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
